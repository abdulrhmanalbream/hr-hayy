# Postgres connection (local embedded in dev — a hosted Postgres like Neon/Supabase in production)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5503/personnel"

# JWT session signing secret — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=""

# Public base URL
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# --- Google Sign-In for staff login (/login) — "Sign in with Google" button ---
# ID-token flow only (Google Identity Services), so no client secret is needed —
# the server verifies the token's signature against Google's public JWKS.
# Public by design (embedded in browser JS) — safe to commit/share, unlike a secret.
#
# How to get/update this value:
#   1. https://console.cloud.google.com/auth/clients (Google Auth Platform → Clients)
#      — pick or create a project.
#   2. Open the existing "Web client" or click "Create OAuth client ID":
#        Application type: Web application
#   3. Under "Authorized JavaScript origins", add every URL the login page is
#      served from — e.g. https://your-app.vercel.app AND http://localhost:3010
#      for local dev. Without localhost listed here, the button will fail (or
#      not render) when you run `npm run dev`.
#   4. "Authorized redirect URIs" can stay empty — this flow doesn't redirect.
#   5. Save. Copy the "Client ID" (ends in .apps.googleusercontent.com) — NOT
#      the "Client secret", which this flow never uses — and paste it below.
#   6. Changes to origins can take a few minutes to a few hours to take effect.
#
# Sign-in with Google only works for an EXISTING StaffUser whose `email` field
# matches the Google account — it never creates a new account. Set an
# employee's email from their page in /hr/employees (حساب الدخول card).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
